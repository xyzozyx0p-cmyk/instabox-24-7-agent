[Unit]
Description=InstaBox 24/7 watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=instabox-watchdog
Group=instabox-watchdog
WorkingDirectory=/opt/instabox-24-7-agent
EnvironmentFile=/etc/instabox-watchdog.env
ExecStart=/usr/bin/python3 /opt/instabox-24-7-agent/watchdog/main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/instabox-watchdog

[Install]
WantedBy=multi-user.target
